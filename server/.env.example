# Server Port
PORT=5000

# MongoDB Connection String (Cloud Atlas or Local)
# For Local MongoDB: mongodb://localhost:27017/academic_files
# For Cloud Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/academic_files
MONGO_URI=your_mongodb_connection_string

# JWT Secret for Session & Auth Token Generation (min 32 chars in production)
JWT_SECRET=your_secure_jwt_secret_key_here

# Initial Admin Credentials (used by 'npm run seed:admin')
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@nirmauni.ac.in
ADMIN_PASSWORD=admin123

# Allowed Registration Email Domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=college.edu,student.college.edu,nirmauni.ac.in

# Optional: Cloudflare R2 / AWS S3 Storage (falls back to local uploads if omitted)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# Optional: SMTP Email configuration for OTP emails
# SMTP_USER=
# SMTP_PASS=
